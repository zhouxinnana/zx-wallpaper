{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main wallpaper window and the desktop floating widget.",
  "windows": ["main", "floating-widget"],
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:default",
    "updater:default",
    "process:allow-restart"
  ]
}
