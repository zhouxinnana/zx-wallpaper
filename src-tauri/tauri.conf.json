{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZX Wallpaper",
  "version": "../package.json",
  "identifier": "com.zhouxinnana.zxwallpaper",
  "build": {
    "beforeDevCommand": "npm run vite",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ZX Wallpaper",
        "width": 1220,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680,
        "visible": true
      },
      {
        "label": "floating-widget",
        "title": "ZX Wallpaper Widget",
        "width": 36,
        "height": 132,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    },
    "icon": ["../build/zx-wallpaper.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYxQkE5QkNFMkM4OEM4NUYKUldSZnlJZ3N6cHU2OFd5OEtFNm9jUENxRDBLNUUrQUFuQjhmaVNuc0pycEppOVVTblFXSjdVV1IK",
      "endpoints": [
        "https://github.com/zhouxinnana/zx-wallpaper/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
