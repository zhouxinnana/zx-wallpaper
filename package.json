{
  "name": "zx-wallpaper",
  "version": "0.1.1",
  "private": true,
  "description": "Windows 11 local wallpaper switcher",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"npm:electron:dev\"",
    "electron:dev": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts",
    "test:packaged-preload": "node scripts/verify-packaged-preload.mjs",
    "test:packaged-brand-logo": "node scripts/verify-packaged-brand-logo.mjs",
    "test:startup-visibility": "node scripts/verify-startup-visibility.mjs",
    "test:packaged-wallpaper-switch": "node scripts/verify-packaged-wallpaper-switch.mjs",
    "test:packaged-online-source": "node scripts/verify-packaged-online-source.mjs",
    "test:built-in-sources": "node scripts/verify-built-in-sources.mjs",
    "test:packaged-tray-icon": "node scripts/verify-tray-icon.mjs",
    "dist": "powershell -ExecutionPolicy Bypass -File scripts/package-windows.ps1",
    "dist:unpacked": "powershell -ExecutionPolicy Bypass -File scripts/package-windows.ps1 -Unpacked"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "wallpaper": "^7.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.1",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.zhouxinnana.zxwallpaper",
    "productName": "ZX Wallpaper",
    "afterPack": "scripts/after-pack.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/zx-wallpaper.ico",
        "to": "zx-wallpaper.ico"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "language": 2052
    },
    "win": {
      "icon": "build/zx-wallpaper.ico",
      "target": "nsis",
      "artifactName": "ZX-Wallpaper-Setup-${version}.${ext}"
    }
  }
}
